            "tiers": [
              { "inputTokensAbove": 272000, "input": 16, "output": 60, "cacheRead": 0.8, "cacheWrite": 20 }
            ]
          },
          "contextWindow": 1050000,
          "maxTokens": 128000,
          "thinkingLevelMap": {
            "off": null, "minimal": "low", "low": "low", "medium": "medium",
            "high": "high", "xhigh": "xhigh", "max": "max"
          },
          "compat": {
            "supportsOpenAIGrammarTools": true,
            "supportsAdditionalTools": true,
            "supportsToolSearch": true,
            "supportsMidConvoSystemMessages": true
          },
          "inputLimits": {
            "images": {
              "resize": { "maxWidth": 2000, "maxHeight": 2000, "maxBytes": 4718592, "jpegQuality": 80 }
            }
          }
        }
      ],
      "modelOverrides": {
        "gpt-6-astra": { "contextWindow": 1050000 }
      }
    },
    "openrouter": {
      // TMP: drop once the pi.dev catalog lists google/gemini-4-carbon (a models[]
