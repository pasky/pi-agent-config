{
  "providers": {
    // TMP: drop the gpt-6.2-astra models[] entries (openai + openai-codex) once the
    // pi.dev catalog lists it. Clones of the catalog's gpt-6-astra entries with
    // OpenRouter's gpt-6.2-astra pricing; window set to 1.05M directly (see below).
    "openai": {
      "models": [
        {
          "id": "gpt-6.2-astra",
          "name": "GPT-6.2 Astra",
          "api": "openai-responses",
          "baseUrl": "https://api.openai.com/v1",
          "reasoning": true,
          "input": ["text", "image"],
          "cost": {
            "input": 8, "output": 40, "cacheRead": 0.4, "cacheWrite": 10,
            "tiers": [
              { "inputTokensAbove": 272000, "input": 16, "output": 60, "cacheRead": 0.8, "cacheWrite": 20 }
            ]
          },
          "contextWindow": 1050000,
          "maxTokens": 128000,
          "thinkingLevelMap": {
            "off": null, "minimal": null, "low": "low", "medium": "medium",
            "high": "high", "xhigh": "xhigh", "max": "max"
          },
          "compat": {
            "supportsStrictMode": true,
            "supportsOpenAIGrammarTools": true,
            "supportsAdditionalTools": true,
            "supportsToolSearch": true,
            "supportsMidConvoSystemMessages": true,
            "supportsExplicitPromptCacheMode": true,
            "supportsMidConvoEffort": true
          },
          "inputLimits": {
            "maxRequestBytes": 536870912,
            "images": {
              "maxPerRequest": 1500,
              "resize": { "maxWidth": 2000, "maxHeight": 2000, "maxBytes": 4718592, "jpegQuality": 80 }
            }
          }
        }
      ],
      "modelOverrides": {
        "gpt-6-astra": { "contextWindow": 1050000 }
      }
    },
    // Must mirror "openai": settings.json compaction reserves 550k for
    // openai-codex/gpt-6.2-astra (formerly gpt-6-astra), which against the
    // catalog's 272k window makes the threshold negative -> compaction after
    // every turn; keep the 1.05M window on any model given that reserve. Codex accepts the 1.05M
    // window as a client-side opt-in (input ceiling 922k).
    "openai-codex": {
      "models": [
        {
          "id": "gpt-6.2-astra",
          "name": "GPT-6.2 Astra",
          "api": "openai-codex-responses",
          "baseUrl": "https://chatgpt.com/backend-api",
          "reasoning": true,
          "input": ["text", "image"],
          "cost": {
            "input": 8, "output": 40, "cacheRead": 0.4, "cacheWrite": 10,
            "tiers": [
              { "inputTokensAbove": 272000, "input": 16, "output": 60, "cacheRead": 0.8, "cacheWrite": 20 }
            ]
          },
          "contextWindow": 1050000,
          "maxTokens": 128000,
          "thinkingLevelMap": {
            "off": null, "minimal": "low", "low": "low", "medium": "medium",
            "high": "high", "xhigh": "xhigh", "max": "max"
          },
          "compat": {
            "supportsOpenAIGrammarTools": true,
            "supportsAdditionalTools": true,
            "supportsToolSearch": true,
            "supportsMidConvoSystemMessages": true
          },
          "inputLimits": {
            "images": {
              "resize": { "maxWidth": 2000, "maxHeight": 2000, "maxBytes": 4718592, "jpegQuality": 80 }
            }
          }
        }
      ],
      "modelOverrides": {
        "gpt-6-astra": { "contextWindow": 1050000 }
      }
    },
    "openrouter": {
      "modelOverrides": {
        // Vertex route is slow/flaky on OpenRouter (48s latency, 61% uptime vs
        // AI Studio 4s, 98%); all our Carbon calls landed on Vertex and timed out.
        // The plain google-ai-studio endpoint caps max_completion_tokens at 32768;
        // the catalog's 943718 made OpenRouter silently filter AI Studio out
        // ("Filter by Context Length"), so maxTokens must stay <= 32768.
        "google/gemini-4-carbon": {
          "maxTokens": 32768,
          "compat": {
            "openRouterRouting": { "order": ["google-ai-studio"], "allow_fallbacks": false }
          }
        },
        "z-ai/glm-5.2": {
          "compat": {
            "openRouterRouting": {
              "order": ["baseten/fp8", "z-ai", "atlas-cloud"],
              "quantizations": ["fp8"],
              "allow_fallbacks": false
            }
          }
        }
      }
    },
    "llama": {
      "baseUrl": "http://192.168.39.2:8888/v1",
      "api": "openai-completions",
      "apiKey": "unused",
      "models": [
        {
          "id": "qwen3.5-35b-a3b",
          "name": "Qwen 3.5 35B-A3B (Local)",
          "reasoning": true,
          "input": ["text"],
          "contextWindow": 128000,
          "maxTokens": 32000,
          "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
          "compat": {
            "maxTokensField": "max_tokens",
            "supportsDeveloperRole": false,
            "thinkingFormat": "qwen"
          }
        }
      ]
    }
  }
}
